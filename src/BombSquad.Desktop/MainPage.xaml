<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BombSquad_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#0B111B">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border
            Background="#111B29"
            BorderBrush="#253246"
            BorderThickness="0,0,1,0">

            <StackPanel Padding="22,28,20,24" Spacing="18">

                <StackPanel Spacing="5">
                    <TextBlock
                        Text="BOMB SQUAD"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#F5F7FB"/>

                    <TextBlock
                        Text="POWER SHELL INSPECTOR"
                        FontSize="10"
                        CharacterSpacing="100"
                        Foreground="#EAB96C"/>
                </StackPanel>

                <Border
                    Height="1"
                    Background="#2B3A50"
                    Margin="0,6,0,6"/>

                <TextBlock
                    Text="WORKSPACE"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#7E90AB"/>

                <Border
                    Background="#233A51"
                    CornerRadius="8"
                    Padding="13,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Text="◈"
                            FontSize="16"
                            Foreground="#EAB96C"/>
                        <TextBlock
                            Text="Inspector"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"/>
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="Analysis overview"
                    FontSize="13"
                    Foreground="#93A4BC"
                    Margin="13,0,0,0"/>

                <TextBlock
                    Text="Detection rules"
                    FontSize="13"
                    Foreground="#93A4BC"
                    Margin="13,0,0,0"/>

                <Border
                    Height="1"
                    Background="#2B3A50"
                    Margin="0,16,0,6"/>

                <TextBlock
                    Text="ENGINE"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#7E90AB"/>

                <TextBlock
                    Text="6 detection families"
                    FontSize="13"
                    Foreground="#D4DFEC"/>

                <TextBlock
                    Text=".NET 10 · PowerShell AST"
                    FontSize="12"
                    Foreground="#8598B3"/>

                <Border
                    Background="#18332C"
                    BorderBrush="#285B48"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,18,0,0">

                    <StackPanel Spacing="5">
                        <TextBlock
                            Text="STATIC ANALYSIS"
                            Foreground="#8CE0B1"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Inspected scripts are never executed."
                            TextWrapping="Wrap"
                            Foreground="#C5DDCF"
                            FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main dashboard -->
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Padding="32,27,32,36"
                Spacing="20">

                <TextBlock
                    Text="WORKSPACE / INSPECTOR"
                    Foreground="#8297B4"
                    FontSize="11"
                    CharacterSpacing="90"/>

                <!-- Header -->
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="7">
                        <TextBlock
                            Text="PowerShell Inspection"
                            FontSize="31"
                            FontWeight="Bold"
                            Foreground="#F6F8FC"/>

                        <TextBlock
                            Text="Understand potential system changes before execution."
                            FontSize="14"
                            Foreground="#A6B4C9"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Run demo inspection"
                        Click="RunDemo_Click"
                        Background="#E9B66B"
                        Foreground="#141922"
                        FontWeight="SemiBold"
                        Padding="18,11"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Current source -->
                <Border
                    Background="#151F2D"
                    BorderBrush="#29384C"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="18,15">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="CURRENT SOURCE"
                                Foreground="#8297B4"
                                FontSize="11"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                x:Name="SourceNameText"
                                Text="No script analyzed"
                                Foreground="#EDF2F9"
                                FontSize="14"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="READ-ONLY"
                            Foreground="#83D8AC"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Statistics -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="#172332"
                        BorderBrush="#29384C"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="COMMANDS FOUND"
                                       Foreground="#91A6BF"
                                       FontSize="11"/>
                            <TextBlock x:Name="CommandCountText"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="AST command nodes"
                                       FontSize="12"
                                       Foreground="#7F91AC"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="#172332"
                        BorderBrush="#29384C"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="REVIEW FINDINGS"
                                       Foreground="#91A6BF"
                                       FontSize="11"/>
                            <TextBlock x:Name="FindingCountText"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#EAB96C"/>
                            <TextBlock Text="Potential operations"
                                       FontSize="12"
                                       Foreground="#7F91AC"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="#172332"
                        BorderBrush="#29384C"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="PARSER DIAGNOSTICS"
                                       Foreground="#91A6BF"
                                       FontSize="11"/>
                            <TextBlock x:Name="DiagnosticCountText"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#B8C8DD"/>
                            <TextBlock Text="Syntax diagnostics"
                                       FontSize="12"
                                       Foreground="#7F91AC"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Findings and details -->
                <Grid ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="#151F2D"
                        BorderBrush="#29384C"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="17">

                        <StackPanel Spacing="13">
                            <TextBlock
                                Text="Detection findings"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#F3F6FA"/>

                            <TextBlock
                                Text="Select a finding to inspect its evidence."
                                FontSize="12"
                                Foreground="#8FA3BB"
                                TextWrapping="Wrap"/>

                            <ListView
                                x:Name="FindingsList"
                                Height="350"
                                Background="Transparent"
                                SelectionMode="Single"
                                SelectionChanged="FindingsList_SelectionChanged">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,10" Spacing="5">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#F1F4F9"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding RuleId}"
                                                FontSize="12"
                                                Foreground="#EAB96C"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="#151F2D"
                        BorderBrush="#29384C"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="18">

                        <ScrollViewer Height="420">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="Finding details"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F3F6FA"/>

                                <TextBlock
                                    x:Name="DetailsTitleText"
                                    Text="Select a finding"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#EAB96C"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="LocationText"
                                    Text="No location selected"
                                    FontSize="12"
                                    Foreground="#91A6BF"/>

                                <TextBlock
                                    Text="EVIDENCE"
                                    Foreground="#7F96B5"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <Border
                                    Background="#0D1622"
                                    CornerRadius="7"
                                    Padding="12">
                                    <TextBlock
                                        x:Name="EvidenceText"
                                        Text="Run an inspection to view source evidence."
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="#D8E5F1"/>
                                </Border>

                                <TextBlock
                                    Text="POTENTIAL EFFECT"
                                    Foreground="#7F96B5"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="PotentialEffectText"
                                    Text="No analysis available."
                                    TextWrapping="Wrap"
                                    FontSize="13"
                                    Foreground="#CFD9E8"/>

                                <TextBlock
                                    Text="LIMITATIONS"
                                    Foreground="#7F96B5"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="LimitationsText"
                                    Text="Findings describe potential behavior, not confirmed execution."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="#A8B8CD"/>

                                <TextBlock
                                    Text="NEXT STEP"
                                    Foreground="#7F96B5"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="NextStepText"
                                    Text="Inspect a script to begin."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="#C9D8E8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border
                    Background="#14231E"
                    BorderBrush="#294E40"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="15">

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="ANALYSIS STATUS"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Foreground="#81D3A6"/>

                        <TextBlock
                            x:Name="ParseStatusText"
                            Text="Ready. No analysis has been performed."
                            Foreground="#D8E9DE"
                            FontSize="13"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="No findings does not mean a script is safe. BOMB SQUAD never executes inspected PowerShell."
                            FontSize="12"
                            Foreground="#A4C5B3"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
