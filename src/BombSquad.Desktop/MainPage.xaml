<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BombSquad_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#F2F4F2">

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CharacterSpacing" Value="35"/>
            <Setter Property="Foreground" Value="#687671"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#697671"/>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- A compact, persistent product header instead of a marketing masthead. -->
        <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                BorderThickness="0,0,0,1">
            <Grid Padding="30,14,30,14" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="45" Height="45"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Source="ms-appx:///Assets/Square44x44Logo.png"
                       AutomationProperties.Name="BOMB SQUAD security inspection emblem"/>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="BOMB SQUAD" FontFamily="Bahnschrift"
                               FontSize="25" FontWeight="SemiBold"
                               CharacterSpacing="18" Foreground="#20292D"/>
                    <TextBlock Text="PowerShell Change &amp; Risk Inspector"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#77827F"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <Border BorderBrush="#CBDCD3" Background="#EFF6F1"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="#45765E"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Local · static analysis"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#315B45"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v0.4 development" FontFamily="Consolas"
                               FontSize="12" Foreground="#798680"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The inspection work surface owns the vertical scroll region. -->
        <ScrollViewer x:Name="ReviewWorkspaceScrollViewer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="30,24,30,28" Spacing="17">

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="INSPECTION WORKSPACE"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Inspect source. Understand potential changes."
                                   FontFamily="Bahnschrift" FontSize="28"
                                   FontWeight="SemiBold" Foreground="#20292D"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Read-only PowerShell analysis. Findings are leads for review, not proof of execution."
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#5D6966" TextWrapping="Wrap"/>
                        <TextBlock Text="SHORTCUTS  /  Ctrl+O open   Ctrl+D sample   Ctrl+S export   Ctrl+E source   Alt+Left back"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#73837D" TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="OpenFileButton" Content="Open .ps1 file"
                                Click="OpenFile_Click"
                                AutomationProperties.Name="Choose a PowerShell file for read-only analysis"
                                Background="#C5533F" Foreground="#FFFFFF"
                                BorderThickness="0" CornerRadius="5"
                                FontFamily="Segoe UI" FontSize="14"
                                FontWeight="SemiBold" Padding="19,13" ToolTipService.ToolTip="Open a PowerShell .ps1 file (Ctrl+O)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="DemoInspectionButton" Content="Try sample"
                                Click="RunDemo_Click"
                                AutomationProperties.Name="Inspect the built-in demonstration source"
                                Background="#FFFFFF" Foreground="#253138"
                                BorderBrush="#CDD8D1" BorderThickness="1"
                                CornerRadius="5" FontFamily="Segoe UI"
                                FontSize="14" FontWeight="SemiBold" Padding="18,13" ToolTipService.ToolTip="Inspect the built-in example (Ctrl+D)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="D" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="ExportReportButton" Content="Export report"
                                Click="ExportReport_Click" IsEnabled="False"
                                AutomationProperties.Name="Export the current static analysis as a JSON report"
                                Background="#FFFFFF" Foreground="#253138"
                                BorderBrush="#CDD8D1" BorderThickness="1"
                                CornerRadius="5" FontFamily="Segoe UI"
                                FontSize="14" FontWeight="SemiBold" Padding="18,13" ToolTipService.ToolTip="Save the current JSON analysis report (Ctrl+S)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="OpenSourceButton" Content="View source"
                                Click="OpenSource_Click" IsEnabled="False"
                                AutomationProperties.Name="Open a dedicated read-only source explorer"
                                Background="#EDF1EF" Foreground="#253138"
                                BorderBrush="#CBD9D2" BorderThickness="1"
                                CornerRadius="5" FontFamily="Segoe UI"
                                FontSize="14" FontWeight="SemiBold" Padding="18,13" ToolTipService.ToolTip="Open read-only Source Explorer (Ctrl+E)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Real source state; no simulated uploaded file or fake picker. -->
                <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                        BorderThickness="1" CornerRadius="7" Padding="16,13">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#EDF1EF" CornerRadius="5"
                                Width="44" Height="44" VerticalAlignment="Center">
                            <TextBlock Text="PS1" FontFamily="Consolas" FontSize="13"
                                       FontWeight="Bold" Foreground="#4E5F5A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="ANALYSIS SOURCE"
                                       Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SourceNameText"
                                       Text="No source analyzed"
                                       FontFamily="Consolas" FontSize="14"
                                       Foreground="#222F34" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="READ ONLY"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="#45765E" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- One consolidated instrument strip; no dashboard metric cards. -->
                <Border Background="#253138" CornerRadius="7" Padding="21,17">
                    <Grid ColumnSpacing="17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="CommandCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#FFFFFF"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Commands found" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="AST command nodes" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Fill="#506168"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="FindingCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#F2B59E"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Findings to review" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="Conditional patterns" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Fill="#506168"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="DiagnosticCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#FFFFFF"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Parser diagnostics" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="Syntax issues" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primary workflow: register on the left, selected evidence on the right. -->
                <Grid ColumnSpacing="17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="1.08*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                            BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <Grid Padding="19,18,19,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="RegisterKickerText" Text="FINDING REGISTER"
                                               Style="{StaticResource SectionLabel}"/>
                                    <TextBlock x:Name="RegisterTitleText" Text="Items for review" FontFamily="Bahnschrift"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="#223036"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="SELECT TO EXAMINE"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#8A9691" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#E8ECE9"/>
                            <TextBlock x:Name="RegisterHintText" Text="Detection rules report potential operations, not confirmed effects."
                                       FontSize="13" Foreground="#697671"
                                       TextWrapping="Wrap" Margin="19,12,19,5"/>
                            <ListView x:Name="FindingsList"
                                      Margin="10,0,10,12" Height="388"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="Detected PowerShell findings"
                                      SelectionChanged="FindingsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,10,8,10" ColumnSpacing="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" Height="46"
                                                    Background="#C5533F" CornerRadius="2"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding RuleId}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="#B34C38"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="Segoe UI" FontSize="15"
                                                           FontWeight="SemiBold" Foreground="#233137"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Family}"
                                                           FontSize="12" Foreground="#737F7A"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›"
                                                       FontSize="24" Foreground="#84918D"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <!-- Parser errors replace findings only when parsing is incomplete. -->
                            <ListView x:Name="DiagnosticsList"
                                      Margin="10,0,10,12" Height="388"
                                      Visibility="Collapsed"
                                      Background="Transparent" BorderThickness="0"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="PowerShell parser diagnostics"
                                      SelectionChanged="DiagnosticsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,10,8,10" ColumnSpacing="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" Height="46"
                                                    Background="#C5533F" CornerRadius="2"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Code}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="#B34C38"/>
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Segoe UI" FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#233137" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="Line"
                                                               FontSize="12" Foreground="#737F7A"/>
                                                    <TextBlock Text="{Binding SourceSpan.StartLine}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               Foreground="#737F7A"/>
                                                    <TextBlock Text="· Column"
                                                               FontSize="12" Foreground="#737F7A"/>
                                                    <TextBlock Text="{Binding SourceSpan.StartColumn}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               Foreground="#737F7A"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›"
                                                       FontSize="24" Foreground="#84918D"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFFFFF"
                            BorderBrush="#DCE2DD" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <Grid Padding="19,18,19,14" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SELECTED EVIDENCE"
                                               Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Examination details" FontFamily="Bahnschrift"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="#223036"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Spacing="9" VerticalAlignment="Center">
                                    <Button x:Name="JumpToSourceButton"
                                            Content="Inspect source"
                                            Click="JumpToSource_Click"
                                            IsEnabled="False"
                                            Background="#EDF1EF" Foreground="#253138"
                                            BorderBrush="#CBD9D2" BorderThickness="1"
                                            CornerRadius="4" Padding="9,6"
                                            FontFamily="Segoe UI" FontSize="12"/>
                                    <Border Background="#EEF2EF" Padding="10,6"
                                            CornerRadius="4">
                                        <TextBlock Text="AST / READ ONLY"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="#516A5D"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="#E8ECE9"/>
                            <ScrollViewer Height="414" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Padding="20,17,20,22" Spacing="10">
                                    <TextBlock x:Name="DetailsTitleText"
                                               Text="Select a finding"
                                               FontFamily="Bahnschrift" FontSize="21"
                                               FontWeight="SemiBold" Foreground="#202B30"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LocationText"
                                               Text="No evidence selected"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#64716F" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="EvidenceLabelText" Text="Original source" Style="{StaticResource DetailLabel}"
                                               Margin="0,7,0,0"/>
                                    <Border Background="#222E34" CornerRadius="5"
                                            BorderBrush="#222E34" BorderThickness="1"
                                            Padding="15,14">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="POWERSHELL / EVIDENCE"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#B9CBC7"/>
                                            <TextBlock x:Name="EvidenceText"
                                                       Text="Run the sample inspection to view source evidence."
                                                       FontFamily="Consolas" FontSize="12"
                                                       Foreground="#FCFDFC" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Potential effect" Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock x:Name="PotentialEffectText"
                                               Text="No analysis available."
                                               FontFamily="Segoe UI" FontSize="14"
                                               Foreground="#29373B" TextWrapping="Wrap"/>
                                    <TextBlock Text="Known limitations" Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <Border Background="#F5F7F5" CornerRadius="5"
                                            Padding="13,11">
                                        <TextBlock x:Name="LimitationsText"
                                                   Text="Static inspection cannot verify runtime effects."
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   Foreground="#53615C" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="Recommended next step"
                                               Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <Border Background="#F6F4EE" CornerRadius="5"
                                            Padding="13,11">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="#C5533F" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Grid.Column="1" x:Name="NextStepText"
                                                       Text="Inspect the source and its context before running it."
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       Foreground="#4B4E44" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>


            </StackPanel>
        </ScrollViewer>

        <!-- Separate source workspace keeps only one scrollable code surface. -->
        <Border x:Name="SourceExplorerSection" Grid.Row="1"
                Visibility="Collapsed" Margin="30,20,30,18"
                Background="#FFFFFF" BorderBrush="#DCE2DD"
                        BorderThickness="1" CornerRadius="7">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Padding="19,16,19,13" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="SOURCE EXPLORER"
                                           Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Original script · line by line"
                                           FontFamily="Bahnschrift" FontSize="22"
                                           FontWeight="SemiBold" Foreground="#223036"/>
                                <TextBlock x:Name="SourceDocumentNameText"
                                           Text="No script loaded"
                                           FontSize="12" FontFamily="Consolas"
                                           Foreground="#687671"/>
                                <TextBlock x:Name="SourceLocationHintText"
                                           Text="Select an inspection record to see its source location."
                                           FontSize="12" FontFamily="Consolas"
                                           Foreground="#B34C38" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <Button Content="Back to inspection"
                                        Click="BackToReview_Click"
                                        AutomationProperties.Name="Return to the inspection workspace"
                                        Background="#FFFFFF" Foreground="#253138"
                                        BorderBrush="#CDD8D1" BorderThickness="1"
                                        CornerRadius="5" Padding="14,9"
                                        FontSize="13" FontWeight="SemiBold" ToolTipService.ToolTip="Return to inspection (Alt+Left)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Left" Modifiers="Menu"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Border Background="#EEF2EF"
                                        CornerRadius="4" Padding="10,7"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ORIGINAL TEXT / READ ONLY"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#516A5D"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <ListView Grid.Row="1" x:Name="SourceLinesList"
                                  Margin="10,0,10,0"
                                  Background="#222E34" BorderThickness="0"
                                  SelectionMode="Single"
                                  AutomationProperties.Name="Read-only original PowerShell source with numbered lines"
                                  SelectionChanged="SourceLinesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="15" Margin="4,3,6,3"
                                          MinHeight="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LineNumberDisplay}"
                                                   TextAlignment="Right"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#B4C5C9"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   Foreground="#F4F7F7"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="2" Background="#F5F7F5"
                                Padding="19,12" CornerRadius="0,0,7,7">
                            <TextBlock x:Name="SourceLineStatusText"
                                       Text="Open a file or try the sample to examine original source."
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#53615C" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

        <!-- Persistent status line communicates limits, never a safety verdict. -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DCE2DD"
                BorderThickness="0,1,0,0" Padding="30,10,30,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="ParseStatusText"
                               Text="Ready. No inspection performed."
                               FontFamily="Consolas" FontSize="12"
                               Foreground="#35463E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ExportStatusText" Text=""
                               Visibility="Collapsed"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#45765E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="No findings does not mean safe. Inspected PowerShell is never executed."
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#77827F" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="BOMB SQUAD · DESKTOP PREVIEW"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#96A19D" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
