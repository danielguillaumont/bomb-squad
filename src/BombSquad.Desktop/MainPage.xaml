<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BombSquad_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#F2F4F2">

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CharacterSpacing" Value="35"/>
            <Setter Property="Foreground" Value="#687671"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#697671"/>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- A compact, persistent product header instead of a marketing masthead. -->
        <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                BorderThickness="0,0,0,1">
            <Grid Padding="30,14,30,14" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="45" Height="45" Background="#253138"
                        CornerRadius="7" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="BS" FontFamily="Bahnschrift"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="18" Height="3" Fill="#CE5944"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="BOMB SQUAD" FontFamily="Bahnschrift"
                               FontSize="25" FontWeight="SemiBold"
                               CharacterSpacing="18" Foreground="#20292D"/>
                    <TextBlock Text="PowerShell Change &amp; Risk Inspector"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#77827F"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <Border BorderBrush="#CBDCD3" Background="#EFF6F1"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="#45765E"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Local · static analysis"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#315B45"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v0.3 preview" FontFamily="Consolas"
                               FontSize="12" Foreground="#798680"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The inspection work surface owns the vertical scroll region. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="30,24,30,28" Spacing="17">

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="INSPECTION WORKSPACE"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Inspect source. Understand potential changes."
                                   FontFamily="Bahnschrift" FontSize="28"
                                   FontWeight="SemiBold" Foreground="#20292D"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Read-only PowerShell analysis. Findings are leads for review, not proof of execution."
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#5D6966" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run sample inspection  →"
                            Click="RunDemo_Click"
                            AutomationProperties.Name="Run the built-in sample inspection"
                            Background="#C5533F" Foreground="#FFFFFF"
                            BorderThickness="0" CornerRadius="5"
                            FontFamily="Segoe UI" FontSize="14"
                            FontWeight="SemiBold" Padding="21,13"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Real source state; no simulated uploaded file or fake picker. -->
                <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                        BorderThickness="1" CornerRadius="7" Padding="16,13">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#EDF1EF" CornerRadius="5"
                                Width="44" Height="44" VerticalAlignment="Center">
                            <TextBlock Text="PS1" FontFamily="Consolas" FontSize="13"
                                       FontWeight="Bold" Foreground="#4E5F5A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="ANALYSIS SOURCE"
                                       Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SourceNameText"
                                       Text="No source analyzed"
                                       FontFamily="Consolas" FontSize="14"
                                       Foreground="#222F34" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="READ ONLY"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="#45765E" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- One consolidated instrument strip; no dashboard metric cards. -->
                <Border Background="#253138" CornerRadius="7" Padding="21,17">
                    <Grid ColumnSpacing="17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="CommandCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#FFFFFF"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Commands found" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="AST command nodes" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Fill="#506168"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="FindingCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#F2B59E"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Findings to review" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="Conditional patterns" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Fill="#506168"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="15">
                            <TextBlock x:Name="DiagnosticCountText" Text="—"
                                       FontFamily="Bahnschrift" FontSize="42"
                                       FontWeight="Bold" Foreground="#FFFFFF"
                                       VerticalAlignment="Center" MinWidth="38"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Parser diagnostics" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F3F5F4"/>
                                <TextBlock Text="Syntax issues" FontSize="12"
                                           Foreground="#ABBDB9"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primary workflow: register on the left, selected evidence on the right. -->
                <Grid ColumnSpacing="17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="1.08*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF" BorderBrush="#DCE2DD"
                            BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <Grid Padding="19,18,19,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="FINDING REGISTER"
                                               Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Items for review" FontFamily="Bahnschrift"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="#223036"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="SELECT TO EXAMINE"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#8A9691" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#E8ECE9"/>
                            <TextBlock Text="Detection rules report potential operations, not confirmed effects."
                                       FontSize="13" Foreground="#697671"
                                       TextWrapping="Wrap" Margin="19,12,19,5"/>
                            <ListView x:Name="FindingsList"
                                      Margin="10,0,10,12" Height="388"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="Detected PowerShell findings"
                                      SelectionChanged="FindingsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,10,8,10" ColumnSpacing="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" Height="46"
                                                    Background="#C5533F" CornerRadius="2"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding RuleId}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="#B34C38"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="Segoe UI" FontSize="15"
                                                           FontWeight="SemiBold" Foreground="#233137"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Family}"
                                                           FontSize="12" Foreground="#737F7A"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›"
                                                       FontSize="24" Foreground="#84918D"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFFFFF"
                            BorderBrush="#DCE2DD" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <Grid Padding="19,18,19,14" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SELECTED EVIDENCE"
                                               Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Examination details" FontFamily="Bahnschrift"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="#223036"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EEF2EF"
                                        Padding="10,6" CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="AST / READ ONLY"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#516A5D"/>
                                </Border>
                            </Grid>
                            <Rectangle Height="1" Fill="#E8ECE9"/>
                            <ScrollViewer Height="414" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Padding="20,17,20,22" Spacing="10">
                                    <TextBlock x:Name="DetailsTitleText"
                                               Text="Select a finding"
                                               FontFamily="Bahnschrift" FontSize="21"
                                               FontWeight="SemiBold" Foreground="#202B30"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LocationText"
                                               Text="No evidence selected"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#64716F" TextWrapping="Wrap"/>
                                    <TextBlock Text="Original source" Style="{StaticResource DetailLabel}"
                                               Margin="0,7,0,0"/>
                                    <Border Background="#222E34" CornerRadius="5"
                                            BorderBrush="#222E34" BorderThickness="1"
                                            Padding="15,14">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="POWERSHELL / EVIDENCE"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#B9CBC7"/>
                                            <TextBlock x:Name="EvidenceText"
                                                       Text="Run the sample inspection to view source evidence."
                                                       FontFamily="Consolas" FontSize="12"
                                                       Foreground="#FCFDFC" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Potential effect" Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock x:Name="PotentialEffectText"
                                               Text="No analysis available."
                                               FontFamily="Segoe UI" FontSize="14"
                                               Foreground="#29373B" TextWrapping="Wrap"/>
                                    <TextBlock Text="Known limitations" Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <Border Background="#F5F7F5" CornerRadius="5"
                                            Padding="13,11">
                                        <TextBlock x:Name="LimitationsText"
                                                   Text="Static inspection cannot verify runtime effects."
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   Foreground="#53615C" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="Recommended next step"
                                               Style="{StaticResource DetailLabel}"
                                               Margin="0,5,0,0"/>
                                    <Border Background="#F6F4EE" CornerRadius="5"
                                            Padding="13,11">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="#C5533F" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Grid.Column="1" x:Name="NextStepText"
                                                       Text="Inspect the source and its context before running it."
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       Foreground="#4B4E44" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Persistent status line communicates limits, never a safety verdict. -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DCE2DD"
                BorderThickness="0,1,0,0" Padding="30,10,30,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="ParseStatusText"
                               Text="Ready. No inspection performed."
                               FontFamily="Consolas" FontSize="12"
                               Foreground="#35463E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="No findings does not mean safe. Inspected PowerShell is never executed."
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#77827F" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="BOMB SQUAD · DESKTOP PREVIEW"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#96A19D" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
